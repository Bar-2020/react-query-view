{
  "name": "react-query-view",
  "version": "0.2.0",
  "description": "A declarative render-state manager for @tanstack/react-query",
  "keywords": [
    "react",
    "react-query",
    "tanstack-query",
    "tanstack",
    "loading-state",
    "error-state",
    "empty-state",
    "async",
    "typescript"
  ],
  "author": "Bar-2020 (https://github.com/Bar-2020)",
  "license": "MIT",
  "homepage": "https://github.com/Bar-2020/react-query-view#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bar-2020/react-query-view.git"
  },
  "bugs": {
    "url": "https://github.com/Bar-2020/react-query-view/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tanstack/react-query": "^5.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.9.9",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^2.0.0"
  }
}
